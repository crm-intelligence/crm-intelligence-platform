{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Microsoft.Teams": {
      "Level": "info"
    }
  },
  "BackendApi": {
    "BaseUrl": "https://localhost:7090",
    "TimeoutSeconds": 15,
    "InternalApiKey": ""
  },
  "CopilotStudio": {
    "Enabled": false,
    "DirectLineBaseUri": "https://europe.directline.botframework.com",
    "AgentName": "",
    "RequestTimeoutSeconds": 30
  },
  "Teams": {
    "SkipAuth": true
  },
  "TeamsUserAuthentication": {
    "Mode": "Development",
    "OAuthConnectionName": ""
  },
  "ReportNotifications": {
    "Enabled": false
  }
}
