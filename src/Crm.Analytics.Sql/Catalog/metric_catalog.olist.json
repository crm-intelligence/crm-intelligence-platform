      "source": "vw_sales",
      "unit": "BRL",
      "valueType": "currency",
      "format": "#,##0.00",
      "aliases": ["musterinin odedigi", "toplam tutar", "customer paid total", "paid amount"],
      "compatibleDimensions": ["customer_state", "customer_city", "product_category", "order_status", "order_purchase_timestamp"],
      "compatibleFilters": ["customer_state", "customer_city", "product_category", "order_status", "order_purchase_timestamp"],
      "requiresDateRange": true,
      "queryMappingReference": "metric.customer_paid_total.v1",
      "approvalStatus": "businessApprovalPending",
      "approvalNote": "\"Net satis\" adayi 2: kargo DAHIL. Adlandirma karari BI'dan bekleniyor."
    },

    "freight_total": {
      "label": "Kargo Tutari",
      "description": "Siparis kalemlerine ait kargo ucretlerinin toplami.",
