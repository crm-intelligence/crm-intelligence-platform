      "requiresDateRange": true,
      "queryMappingReference": "metric.avg_basket.v1",
      "approvalStatus": "businessApprovalPending",
      "approvalNote": "Pay olarak item_sales kullanildi; customer_paid_total secilirse bu ifade de guncellenmelidir. NULLIF sifira bolmeyi ve hata tabanli deger cikarimini engeller.",
      "dependsOn": ["item_sales", "order_count"]
