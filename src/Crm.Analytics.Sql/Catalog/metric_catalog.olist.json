      "approvalNote": "Siparis sayisindan farklidir: bir siparis birden fazla kalem icerir (112.650 kalem / 99.441 siparis)."
    },

    "avg_basket": {
      "label": "Ortalama Sepet",
      "description": "Kargo haric urun satis tutarinin tekil siparis sayisina orani.",
