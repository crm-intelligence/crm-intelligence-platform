{
  "_meta": {
    "status": "GORUNUM BEKLIYOR — olist_views.contract.sql'deki gorunumlere dayanir",
    "source": "data/fixtures/olist/ kolon adlari dogrulanarak yazildi (2026-07-30).",
    "aliasConvention": "expression alanlarinda tablo alias'i KULLANILMAZ, yalnizca kolon adi yazilir. CatalogValidator kolonun hangi objeye ait oldugunu allow-list'ten cozer; Query Builder AST uzerinde dogru alias ile niteler. Boylece string birlestirme de, alias cakismasi da olmaz.",
    "netSalesDecision": "\"Net satis\"in price mi, price+freight_value mi oldugu IS KARARIDIR ve BI onayina birakilmistir. Iki aday da ayri metrik olarak tanimli ve ikisi de businessApprovalPending. Karar gelene kadar hicbiri 'net_sales' anahtarini almadi — sessiz varsayim yapilmadi."
  },

  "metrics": {
    "item_sales": {
      "label": "Urun Satis Tutari",
      "description": "Satilan urun kalemlerinin kargo haric fiyat toplami.",
      "kind": "aggregate",
      "expression": "SUM(price)",
      "source": "vw_sales",
      "unit": "BRL",
      "valueType": "currency",
      "format": "#,##0.00",
      "aliases": ["satis tutari", "urun tutari", "ciro", "item sales", "sales amount"],
      "compatibleDimensions": ["customer_state", "customer_city", "product_category", "order_status", "order_purchase_timestamp"],
      "compatibleFilters": ["customer_state", "customer_city", "product_category", "order_status", "order_purchase_timestamp"],
      "requiresDateRange": true,
      "queryMappingReference": "metric.item_sales.v1",
      "approvalStatus": "businessApprovalPending",
      "approvalNote": "\"Net satis\" adayi 1: kargo HARIC. Adlandirma karari BI'dan bekleniyor."
    },

    "customer_paid_total": {
      "label": "Musteri Odemesi (Urun + Kargo)",
      "description": "Musterinin urun ve kargo icin odedigi toplam tutar.",
