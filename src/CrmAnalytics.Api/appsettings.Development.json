{
  "Analytics": {
    "Provider": "Mock"
  },
  "Reporting": {
    "Provider": "Mock"
  },
  "SqlProduction": {
    "Provider": "Mock",
    "SqlVersionName": "Sql150",
    "ConfidenceThreshold": 0.60
  },
  "Ollama": {
    "Enabled": false,
    "PlanningMode": "LlmFirst",
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3:8b",
    "TimeoutSeconds": 45,
    "Temperature": 0,
    "KeepAlive": "10m"
  },
  "SemanticEmbedding": {
    "Enabled": true,
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3-embedding:0.6b",
    "TimeoutSeconds": 15,
    "CandidateCount": 3,
    "RetrievalPoolSize": 6,
    "MinSimilarity": 0.70,
    "AmbiguityMargin": 0.02,
    "PartialQwenMinSimilarity": 0.55,
    "MinLexicalEvidenceForBypass": 2,
    "UnsupportedHighMargin": 0.05,
    "MaximumPhraseTokens": 8,
    "MaximumRepresentations": 64,
    "ConceptPresenceSimilarity": 0.35
  },
  "QueryExecution": {
    "Provider": "Mock"
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Messaging": {
    "Provider": "InMemory"
  },
  "CrmAnalyticsAuthentication": {
    "Mode": "Development",
    "RequiredScope": "access_as_user",
    "Development": {
      "UserId": "11111111-1111-4111-8111-111111111111",
      "TenantId": "22222222-2222-4222-8222-222222222222",
      "Roles": [
        "Report.User"
      ]
    }
  },
  "ReportDataAccess": {
    "Provider": "Configuration",
    "Assignments": [
      {
        "TenantId": "22222222-2222-4222-8222-222222222222",
        "UserId": "11111111-1111-4111-8111-111111111111",
        "AllowAllRegions": true,
        "AllowAllStores": true,
        "AllowedRegions": [],
        "AllowedStoreIds": []
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ExternalServices": {
    "Mocks": {
      "DelayMilliseconds": 50,
      "PowerBiBaseUrl": "https://app.powerbi.com/demo/reports",
      "ForceQueryPlanningFailure": false,
      "ForceAnalyticsFailure": false,
      "ForceReportFailure": false,
      "ForceClarification": false
    }
  },
  "ReportProcessing": {
    "Queue": {
      "Enabled": true,
      "Capacity": 100
    }
  },
  "OutboxDispatcher": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 1,
    "LockDurationSeconds": 60,
    "MaxAttempts": 10,
    "BaseRetryDelaySeconds": 1,
    "MaxRetryDelaySeconds": 30,
    "PublishedRetentionDays": 7
  },
  "TeamsNotifications": {
    "Enabled": false,
    "BaseUrl": "http://localhost:3978",
    "TimeoutSeconds": 10,
    "TargetNotReadyRetryCount": 5,
    "TargetNotReadyInitialDelayMilliseconds": 100
  }
}
