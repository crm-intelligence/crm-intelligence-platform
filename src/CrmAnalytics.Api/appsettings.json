{
  "CrmAnalyticsAuthentication": {
    "Mode": "Entra",
    "RequiredScope": "access_as_user",
    "Development": {
      "UserId": "",
      "TenantId": "",
      "Roles": []
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "ReportAuthorization": {
    "RolePermissions": {
      "Report.User": [
        "Create",
        "ReadOwn",
        "ReviseOwn",
        "ClarifyOwn",
        "ViewOwnHistory"
      ],
      "Report.Viewer": [
        "ReadOwn",
        "ViewOwnHistory"
      ],
      "Report.Admin": [
        "Create",
        "ReadOwn",
        "ReviseOwn",
        "ClarifyOwn",
        "ViewOwnHistory"
      ]
    }
  },
  "ReportDataAccess": {
    "Provider": "SqlServer",
    "Assignments": []
  },
  "Persistence": {
    "Provider": "SqlServer",
    "SqlServer": {
      "CommandTimeoutSeconds": 30,
      "EnableRetryOnFailure": true,
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 30
    }
  },
  "ConnectionStrings": {
    "CrmAnalytics": "",
    "QueryDwh": "",
    "QueryOltp": ""
  },
  "QueryExecution": {
    "Provider": "SqlClient",
    "Dwh": {
      "Enabled": true,
      "AuthenticationMode": "ManagedIdentity",
      "ConnectionStringName": "QueryDwh",
      "ManagedIdentityClientId": "",
      "CommandTimeoutCeilingSeconds": 120,
      "MaxRows": 10000,
      "MaxColumns": 100,
      "MaxCellCharacters": 10000,
      "MaxResultBytes": 10485760,
      "MaxRetryCount": 2,
      "RetryBaseDelayMilliseconds": 500
    },
    "Oltp": {
      "Enabled": false,
      "AuthenticationMode": "ManagedIdentity",
      "ConnectionStringName": "QueryOltp",
      "ManagedIdentityClientId": "",
      "CommandTimeoutCeilingSeconds": 15,
      "MaxRows": 1000,
      "MaxColumns": 50,
      "MaxCellCharacters": 4000,
      "MaxResultBytes": 2097152,
      "MaxRetryCount": 1,
      "RetryBaseDelayMilliseconds": 250
    }
  },
  "SqlProduction": {
    "Provider": "CrmAnalyticsSql",
    "SqlVersionName": "Sql150",
    "ConfidenceThreshold": 0.60
  },
  "Ollama": {
    "Enabled": false,
    "PlanningMode": "LlmFirst",
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3:8b",
    "TimeoutSeconds": 45,
    "Temperature": 0,
    "KeepAlive": "10m"
  },
  "SemanticEmbedding": {
    "Enabled": false,
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3-embedding:0.6b",
    "TimeoutSeconds": 15,
    "CandidateCount": 3,
    "RetrievalPoolSize": 6,
    "MinSimilarity": 0.70,
    "AmbiguityMargin": 0.02,
    "PartialQwenMinSimilarity": 0.55,
    "MinLexicalEvidenceForBypass": 2,
    "UnsupportedHighMargin": 0.05,
    "MaximumPhraseTokens": 8,
    "MaximumRepresentations": 64,
    "ConceptPresenceSimilarity": 0.35
  },
  "Analytics": {
    "Provider": "FabricJob",
    "AllowDirectInProtectedEnvironments": false,
    "Fabric": {
      "WorkspaceId": "",
      "ItemId": "",
      "JobType": "",
      "ScenarioKey": "",
      "PollingIntervalSeconds": 5,
      "TimeoutSeconds": 600,
      "MaxRetries": 4,
      "AuthenticationMode": "ManagedIdentity",
      "ManagedIdentityClientId": ""
    }
  },
  "Reporting": {
    "Provider": "PowerBi",
    "PowerBi": {
      "WorkspaceId": "",
      "ReportId": "",
      "SemanticModelId": "",
      "RefreshBeforeReturn": false,
      "RefreshPollingEnabled": false,
      "RefreshPollingIntervalSeconds": 5,
      "RefreshTimeoutSeconds": 600,
      "MaxRetries": 4,
      "AuthenticationMode": "ManagedIdentity",
      "ManagedIdentityClientId": ""
    }
  },
  "Messaging": {
    "Provider": "AzureServiceBus",
    "AzureServiceBus": {
      "AuthenticationMode": "ManagedIdentity",
      "FullyQualifiedNamespace": "",
      "ConnectionString": "",
      "QueueName": "crm-report-processing",
      "ManagedIdentityClientId": "",
      "PrefetchCount": 0,
      "MaxConcurrentCalls": 1,
      "MaxAutoLockRenewalMinutes": 5,
      "TryTimeoutSeconds": 30,
      "TransportType": "AmqpTcp",
      "Retry": {
        "MaxRetries": 5,
        "DelaySeconds": 1,
        "MaxDelaySeconds": 30,
        "Mode": "Exponential"
      }
    }
  },
  "OutboxDispatcher": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingIntervalSeconds": 2,
    "LockDurationSeconds": 60,
    "MaxAttempts": 10,
    "BaseRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 300,
    "PublishedRetentionDays": 7
  },
  "TeamsNotifications": {
    "Enabled": true,
    "BaseUrl": "https://crm-analytics-teams.example.invalid",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "TargetNotReadyRetryCount": 5,
    "TargetNotReadyInitialDelayMilliseconds": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
