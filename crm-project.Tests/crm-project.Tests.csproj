<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Web uygulamasiyla birlikte net8.0'dan yukseltildi. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>crm_project.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Surumler diger iki test paketiyle hizalandi (Crm.Analytics.Sql.Tests ve
         .IntegrationTests): ayni solution'da iki farkli xunit ana surumu
         bulundurmak, tek `dotnet test` kosumunda kosucu secimini belirsiz birakir. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../crm-project/crm-project.csproj" />
  </ItemGroup>

</Project>
